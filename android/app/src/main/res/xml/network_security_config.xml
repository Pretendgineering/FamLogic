<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed so people can use a server on their home network or a VPN
     such as Tailscale/WireGuard. The app warns when http is used over the internet. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
            <!-- Lets people with a self-signed/home CA install it in Android settings. -->
            <certificates src="user" tools:ignore="AcceptsUserCertificates" />
        </trust-anchors>
    </base-config>
</network-security-config>
